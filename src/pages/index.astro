---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import PostRow from '../components/PostRow.astro';
import { estimateReadingMinutes, getPublishedPosts } from '../lib/posts';

const posts = await getPublishedPosts();
const lead = posts.find((post) => post.data.featured) ?? posts[0];
const rest = posts.filter((post) => post.id !== lead?.id).slice(0, 5);
---

<BaseLayout>
  <Hero />

  {lead && (
    <section class="section latest">
      <div class="container">
        <div class="section-head">
          <h2>Latest writing</h2>
          <a class="link-more" href="/blog">All posts →</a>
        </div>

        <div class="list">
          <PostRow
            variant="lead"
            badge={lead.data.featured ? 'Featured note' : 'Latest note'}
            title={lead.data.title}
            description={lead.data.description}
            href={`/blog/${lead.id}/`}
            date={lead.data.pubDate}
            tags={lead.data.tags}
            minutes={estimateReadingMinutes(lead.body)}
          />
          {rest.map((post) => (
            <PostRow
              variant="row"
              title={post.data.title}
              description={post.data.description}
              href={`/blog/${post.id}/`}
              date={post.data.pubDate}
              tags={post.data.tags}
              minutes={estimateReadingMinutes(post.body)}
            />
          ))}
        </div>
      </div>
    </section>
  )}
</BaseLayout>

<style>
  .latest {
    padding-top: 0;
  }

  .latest .section-head {
    margin-bottom: 1.5rem;
  }

  .latest .list :global(.lead) {
    margin-bottom: 0.5rem;
  }
</style>
