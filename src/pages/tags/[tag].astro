---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostRow from '../../components/PostRow.astro';
import { estimateReadingMinutes, getPublishedPosts } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const tags = [...new Set(posts.flatMap((p) => p.data.tags))];
  return tags.map((tag) => ({
    params: { tag },
    props: { tag },
  }));
}

const { tag } = Astro.props;
const all = await getPublishedPosts();
const posts = all.filter((p) => p.data.tags.includes(tag));
---

<BaseLayout title={tag} description={`All posts tagged “${tag}”.`}>
  <section class="section tag-archive">
    <div class="container">
      <a class="back" href="/tags">← All tags</a>
      <h1 class="display page-title">{tag}</h1>
      <p class="page-intro">{posts.length} {posts.length === 1 ? 'post' : 'posts'}</p>
      <div class="list">
        {posts.map((post) => (
          <PostRow
            title={post.data.title}
            description={post.data.description}
            href={`/blog/${post.id}/`}
            date={post.data.pubDate}
            tags={post.data.tags}
            minutes={estimateReadingMinutes(post.body)}
          />
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-intro {
    margin-bottom: 3rem;
  }

  .list :global(.post-row:last-child) {
    border-bottom: 1px solid var(--line-soft);
  }
</style>
