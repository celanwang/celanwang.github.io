---
interface Props {
  title: string;
  description?: string;
  href: string;
  date: Date;
  tags?: string[];
  minutes?: number;
  variant?: 'lead' | 'row';
  badge?: string;
}

const {
  title,
  description,
  href,
  date,
  tags = [],
  minutes,
  variant = 'row',
  badge,
} = Astro.props;

const y = date.getFullYear();
const m = String(date.getMonth() + 1).padStart(2, '0');
const d = String(date.getDate()).padStart(2, '0');
const dateLabel = `${y}.${m}.${d}`;
const isLead = variant === 'lead';
---

<article class:list={['post-row', variant]} data-post-row>
  <div class="meta">
    {badge && <span class="badge">{badge}</span>}
    <time datetime={date.toISOString()}>{dateLabel}</time>
    {typeof minutes === 'number' && (
      <span class="minutes">{minutes} min read</span>
    )}
    {tags.length > 0 && (
      <ul class="tags">
        {tags.slice(0, isLead ? 3 : 2).map((tag) => (
          <li><a href={`/tags/${encodeURIComponent(tag)}/`}>{tag}</a></li>
        ))}
      </ul>
    )}
  </div>
  <div class="body">
    <h3><a href={href}>{title}</a></h3>
    {description && <p class="summary">{description}</p>}
  </div>
</article>

<style>
  .post-row {
    display: grid;
    gap: 0.65rem;
    padding: 1.65rem 0;
    border-top: 1px solid var(--border-subtle);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem 0.85rem;
    align-items: center;
  }

  .badge {
    color: var(--accent);
    font-size: var(--fs-eyebrow);
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  time,
  .minutes {
    font-size: var(--fs-small);
    font-weight: 400;
    line-height: var(--lh-ui);
    font-variant-numeric: tabular-nums;
    color: var(--text-tertiary);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.65rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tags a {
    display: inline-flex;
    align-items: center;
    min-height: 2rem;
    color: var(--text-tertiary);
    font-size: var(--fs-eyebrow);
    font-weight: 400;
    line-height: var(--lh-ui);
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 0.25em;
    transition: color var(--duration) var(--ease), text-decoration-color var(--duration) var(--ease);
  }

  .tags a:hover {
    color: var(--accent);
    text-decoration-color: currentColor;
  }

  .body h3 {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.4;
    overflow-wrap: anywhere;
    text-wrap: balance;
  }

  .body h3 a {
    display: inline-block;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 0.06em;
    text-underline-offset: 0.2em;
    transition: color var(--duration) var(--ease), text-decoration-color var(--duration) var(--ease);
  }

  .body h3 a:hover {
    color: var(--accent);
    text-decoration-color: currentColor;
  }

  .summary {
    margin: 0.55rem 0 0;
    color: var(--text-secondary);
    max-width: 44rem;
    font-size: var(--fs-summary);
    line-height: var(--lh-summary);
    overflow-wrap: anywhere;
    text-wrap: pretty;
  }

  .lead {
    gap: 0.85rem;
    padding: 0 0 2rem;
    border-top: 0;
  }

  .lead .body h3 {
    font-size: clamp(1.5rem, 3vw, 1.85rem);
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.3;
  }

  .lead .summary {
    margin-top: 0.65rem;
    font-size: var(--fs-body);
  }

  @media (min-width: 860px) {
    .row {
      grid-template-columns: 9.5rem minmax(0, 1fr);
      gap: 2rem;
      align-items: start;
    }

    .row .meta {
      display: block;
      padding-top: 0.2rem;
    }

    .row .minutes {
      display: block;
      margin-top: 0.15rem;
    }

    .row .tags {
      margin-top: 0.4rem;
    }

    .lead {
      grid-template-columns: 1fr;
    }
  }

  @media (pointer: coarse) {
    .tags a {
      min-height: 2.75rem;
    }
  }
</style>
