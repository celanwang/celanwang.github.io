---
interface Props {
  title: string;
  description?: string;
  href: string;
  date: Date;
  tags?: string[];
  minutes?: number;
  variant?: 'lead' | 'row';
  badge?: string;
}

const {
  title,
  description,
  href,
  date,
  tags = [],
  minutes,
  variant = 'row',
  badge,
} = Astro.props;

const y = date.getFullYear();
const m = String(date.getMonth() + 1).padStart(2, '0');
const d = String(date.getDate()).padStart(2, '0');
const dateLabel = `${y}.${m}.${d}`;
const isLead = variant === 'lead';
---

<article class:list={['post-row', variant]} data-post-row>
  <div class="meta">
    {badge && <span class="badge">{badge}</span>}
    <time datetime={date.toISOString()}>{dateLabel}</time>
    {typeof minutes === 'number' && (
      <span class="minutes">{minutes} min read</span>
    )}
    {tags.length > 0 && (
      <ul class="tags">
        {tags.slice(0, isLead ? 3 : 2).map((tag) => (
          <li><a href={`/tags/${encodeURIComponent(tag)}/`}>{tag}</a></li>
        ))}
      </ul>
    )}
  </div>
  <div class="body">
    <h3><a href={href}>{title}</a></h3>
    {description && <p class="summary">{description}</p>}
  </div>
</article>

<style>
  .post-row {
    display: grid;
    gap: 0.75rem;
    padding: 1.5rem 0;
    border-top: 1px solid var(--line-soft);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem 0.9rem;
    align-items: center;
  }

  .badge {
    color: var(--accent);
    font-size: var(--fs-eyebrow);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  time,
  .minutes {
    font-size: var(--fs-small);
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    color: var(--muted);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tags a {
    display: inline-flex;
    align-items: center;
    min-height: 2rem;
    padding: 0.25rem 0.6rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--ink-soft);
    font-size: 0.75rem;
    font-weight: 500;
    line-height: 1.35;
    transition: color var(--duration) var(--ease), border-color var(--duration) var(--ease),
      background var(--duration) var(--ease);
  }

  .tags a:hover {
    color: var(--accent);
    border-color: color-mix(in srgb, var(--accent) 40%, var(--line));
    background: var(--accent-soft);
  }

  .body h3 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.1rem, 1.8vw, 1.28rem);
    font-weight: 600;
    letter-spacing: 0;
    line-height: 1.4;
  }

  .body h3 a {
    display: inline-block;
    transition: color var(--duration) var(--ease);
  }

  .body h3 a:hover {
    color: var(--accent);
  }

  .summary {
    margin: 0.55rem 0 0;
    color: var(--muted);
    max-width: 44rem;
    font-size: 0.98rem;
    line-height: 1.65;
  }

  .lead {
    gap: 1rem;
    padding: 0 0 2rem;
    border-top: 0;
  }

  .lead .body h3 {
    font-size: clamp(1.45rem, 3vw, 1.85rem);
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.3;
    color: var(--ink);
  }

  .lead .body h3 a:hover {
    color: var(--accent);
  }

  .lead .summary {
    margin-top: 0.75rem;
    font-size: 1rem;
    line-height: 1.75;
  }

  @media (min-width: 860px) {
    .row {
      grid-template-columns: 9.5rem 1fr;
      gap: 2rem;
      align-items: baseline;
    }

    .row .meta {
      padding-top: 0.2rem;
    }

    .lead {
      grid-template-columns: 1fr;
    }
  }
</style>
