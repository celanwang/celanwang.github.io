---
const year = new Date().getFullYear();

const nav = [
  { href: '/', label: 'Home' },
  { href: '/blog', label: 'Writing' },
  { href: '/tags', label: 'Tags' },
  { href: '/about', label: 'About' },
];

const social = [
  { href: 'https://github.com/celanwang', label: 'GitHub', external: true },
  { href: 'mailto:lumworn@gmail.com', label: 'Email', external: false },
  { href: '/rss.xml', label: 'RSS', external: false },
];
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-top">
      <p class="footer-signature">think → build → measure → learn ↺</p>
      <ul class="footer-social" aria-label="Elsewhere">
        {social.map((item) => (
          <li>
            <a
              href={item.href}
              {...(item.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div class="footer-bottom">
      <nav class="footer-nav" aria-label="Footer">
        {nav.map((item) => <a href={item.href}>{item.label}</a>)}
      </nav>
      <div class="footer-meta">
        <p>© {year} Chen Wang · bytego.cloud</p>
        <a href="https://beian.miit.gov.cn/" rel="noopener noreferrer" target="_blank">鲁ICP备2025149012号</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--line-soft);
    background: var(--bg);
  }

  .footer-inner {
    padding: 3rem 0 2.5rem;
  }

  .footer-top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem 2rem;
    padding-bottom: 2rem;
  }

  .footer-signature {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--ink-soft);
  }

  .footer-social {
    display: flex;
    gap: 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer-social a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--ink-soft);
    font-size: 0.9375rem;
    font-weight: 500;
    transition: color var(--duration) var(--ease);
  }

  .footer-social a:hover {
    color: var(--accent);
  }

  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.75rem 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line-soft);
  }

  .footer-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
  }

  .footer-nav a {
    display: inline-flex;
    align-items: center;
    min-height: 2rem;
    color: var(--muted);
    font-size: var(--fs-small);
    font-weight: 500;
    transition: color var(--duration) var(--ease);
  }

  .footer-nav a:hover {
    color: var(--ink);
  }

  .footer-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem 1rem;
    text-align: right;
  }

  .footer-meta p {
    margin: 0;
    color: var(--muted);
    font-size: var(--fs-small);
  }

  .footer-meta a {
    display: inline-flex;
    align-items: center;
    min-height: 2rem;
    color: var(--muted);
    font-size: 0.75rem;
    transition: color var(--duration) var(--ease);
  }

  .footer-meta a:hover {
    color: var(--accent);
  }

  @media (max-width: 720px) {
    .footer-meta { text-align: left; }
  }
</style>
